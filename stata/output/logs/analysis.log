.
. foreach control_code in 1 3 {
  2.     if `control_code' == 1 local control_name "English"
  3.     if `control_code' == 3 local control_name "Spanish"
  4.
.     foreach block in before after {
  5.         if "`block'" == "before" {
  6.             local first = td(25mar2024)
  7.             local last  = td(10apr2024)
  8.         }
  9.         else {
 10.             local first = td(05may2024)
 11.             local last  = td(17may2024)
 12.         }
 13.
.         forvalues cutoff = `first'/`last' {
 14.             use `master', clear
 15.             keep if never_edited & inlist(language, 2, `control_code')
 16.             keep if inrange(review_date_num, `cutoff' - 7, `cutoff' + 6)
 17.             replace treat = language == 2
 18.             gen byte placebo_post = review_date_num >= `cutoff'
 19.             capture quietly regress recommended i.treat##i.placebo_post, vce(robust)
 20.             if !_rc {
 21.                 local b = _b[1.treat#1.placebo_post]
 22.                 local s = _se[1.treat#1.placebo_post]
 23.                 local q = invttail(e(df_r), .025)
 24.                 local p = 2 * ttail(e(df_r), abs(`b' / `s'))
 25.                 post `placebo_handle' ("`control_name'") ("placebo") (`cutoff') ///
>                     (`b') (`s') (`b' - `q' * `s') (`b' + `q' * `s') (e(N))
 26.             }
 27.         }
 28.     }
 29.
.     foreach focal in harm repair {
 30.         if "`focal'" == "harm" local cutoff = td(18apr2024)
 31.         else local cutoff = td(26apr2024)
 32.         use `master', clear
 33.         keep if never_edited & inlist(language, 2, `control_code')
 34.         keep if inrange(review_date_num, `cutoff' - 7, `cutoff' + 6)
 35.         replace treat = language == 2
 36.         gen byte placebo_post = review_date_num >= `cutoff'
 37.         quietly regress recommended i.treat##i.placebo_post, vce(robust)
 38.         local b = _b[1.treat#1.placebo_post]
 39.         local s = _se[1.treat#1.placebo_post]
 40.         local q = invttail(e(df_r), .025)
 41.         post `placebo_handle' ("`control_name'") ("focal_`focal'") (`cutoff') ///
>             (`b') (`s') (`b' - `q' * `s') (`b' + `q' * `s') (e(N))
 42.     }
 43. }
